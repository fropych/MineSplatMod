{
  "schemaVersion": 1,
  "id": "minesplat",
  "version": "${version}",
  "name": "MineSplat",
  "description": "Generate a Litematica schematic or optional Chisels & Bits miniature from an image or text prompt with local or remote TripoSplat inference.",
  "authors": [
    "yromko"
  ],
  "contact": {
    "sources": "https://github.com/fropych/MineSplatMod"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.yromko.minesplat.MineSplatClient"
    ],
    "modmenu": [
      "io.github.yromko.minesplat.compat.MineSplatModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "litematica": "${litematica_version}",
    "malilib": ">=${malilib_version} <${malilib_next_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}",
    "chiselsandbits": "${chisels_bits_version}"
  }
}
