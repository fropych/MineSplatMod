{
  "formatVersion": 1,
  "game": "minecraft",
  "versionId": "${version}",
  "name": "MineSplat ${version} for Minecraft ${minecraft_version}",
  "summary": "Client-side image/prompt workflow for Litematica and optional Chisels & Bits.",
  "files": [
    {
      "path": "mods/${fabric_api_file_name}",
      "hashes": {
        "sha512": "${fabric_api_sha512}"
      },
      "env": {
        "client": "required",
        "server": "unsupported"
      },
      "downloads": [
        "${fabric_api_download_url}"
      ],
      "fileSize": ${fabric_api_file_size}
    },
    {
      "path": "mods/${litematica_file_name}",
      "hashes": {
        "sha512": "${litematica_sha512}"
      },
      "env": {
        "client": "required",
        "server": "unsupported"
      },
      "downloads": [
        "${litematica_download_url}"
      ],
      "fileSize": ${litematica_file_size}
    },
    {
      "path": "mods/${malilib_file_name}",
      "hashes": {
        "sha512": "${malilib_sha512}"
      },
      "env": {
        "client": "required",
        "server": "unsupported"
      },
      "downloads": [
        "${malilib_download_url}"
      ],
      "fileSize": ${malilib_file_size}
    },
    {
      "path": "mods/${modmenu_file_name}",
      "hashes": {
        "sha512": "${modmenu_sha512}"
      },
      "env": {
        "client": "required",
        "server": "unsupported"
      },
      "downloads": [
        "${modmenu_download_url}"
      ],
      "fileSize": ${modmenu_file_size}
    }
  ],
  "dependencies": {
    "minecraft": "${minecraft_version}",
    "fabric-loader": "${loader_version}"
  }
}
